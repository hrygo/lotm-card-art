    {
      "id": "eternal-darkness-catchphrase-02",
      "kind": "catchphrase",
      "title": null,
      "text": "终点不是消失，是万物重新对齐的那一刻。",
      "sourceKind": "original",
      "evidenceRefs": [],
      "gap": null,
