    },
    {
      "id": "klein-s09-catchphrase-02",
      "kind": "catchphrase",
      "title": null,
      "text": "灵摆只会指向答案附近；剩下的路，要靠你自己核对。",
      "sourceKind": "original",
      "evidenceRefs": [],
      "gap": null,
