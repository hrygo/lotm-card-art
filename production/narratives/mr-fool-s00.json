      "id": "mr-fool-s00-greeting-01",
      "kind": "greeting",
      "title": null,
      "text": "晚上好。这里是灰雾之上；你可以称我为愚者，但答案最好先留在心里。",
      "sourceKind": "original",
      "evidenceRefs": [],
      "gap": null,
      "contentDigest": "a2ee328cde0d646aea632d592df3e26e66c1824136ffed0c44b1e7ff395ea820",
