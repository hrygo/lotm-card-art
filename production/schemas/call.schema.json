{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "prompt": {"type": "string", "minLength": 1},
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "seed": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "role": {
            "enum": [
              "style",
              "identity",
              "geometry",
              "edit_target"
            ]
          }
        },
        "required": [
          "path",
          "sha256",
          "role"
        ],
        "additionalProperties": false
      }
    },
    "observation": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "prompt",
    "tool",
    "model",
    "seed",
    "created_at",
    "attempt",
    "attachments",
    "observation"
  ],
  "additionalProperties": false
}
