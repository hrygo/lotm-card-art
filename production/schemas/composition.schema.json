{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "nameplate": {
      "type": "object",
      "properties": {
        "rect": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
        "font": {"type": "string", "minLength": 1},
        "size": {"type": "number", "minimum": 32, "maximum": 100},
        "fill": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
        "align": {"enum": ["left", "center", "right"]}
      },
      "required": ["rect", "font", "size", "fill", "align"],
      "additionalProperties": false
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "composition_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "concept",
        "production"
      ]
    },
    "card_id": {
      "type": "string",
      "minLength": 1
    },
    "slot_id": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "enum": [
        "standard",
        "collector"
      ]
    },
    "background": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "receipt": {
            "type": "string",
            "minLength": 1
          },
          "rect": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0
            },
            "minItems": 4,
            "maxItems": 4
          },
          "fit": {
            "enum": [
              "cover",
              "contain"
            ]
          },
          "opacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "receipt",
          "rect",
          "fit",
          "opacity"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "vector_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "shapes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "rect",
              "ellipse",
              "path",
              "text"
            ]
          },
          "rect": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0
            },
            "minItems": 4,
            "maxItems": 4
          },
          "fill": {
            "type": "string",
            "minLength": 1
          },
          "stroke": {
            "type": "string",
            "minLength": 1
          },
          "line_width": {
            "type": "number",
            "minimum": 0
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 1
            }
          },
          "text": {
            "type": "string"
          },
          "font": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "type": "number",
            "minimum": 1
          },
          "align": {
            "enum": [
              "left",
              "center",
              "right"
            ]
          }
        },
        "required": [
          "kind",
          "rect"
        ],
        "additionalProperties": false
      }
    },
    "approval": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "by": {
          "type": [
            "string",
            "null"
          ]
        },
        "reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "image_sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "by",
        "reference",
        "image_sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "nameplate",
    "schema_version",
    "composition_id",
    "mode",
    "card_id",
    "slot_id",
    "profile",
    "background",
    "layers",
    "vector_assets",
    "shapes",
    "approval"
  ],
  "additionalProperties": false
}
