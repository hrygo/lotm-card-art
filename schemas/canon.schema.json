{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.3.0"
    },
    "pathway_id": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "predicate": {
            "enum": [
              "sequence_name",
              "pathway_name",
              "acting_principle",
              "ability",
              "potion_ingredient",
              "ascension_condition",
              "limitation",
              "absence",
              "not_applicable"
            ]
          },
          "value": {
            "type": "string"
          },
          "dimensions": {
            "type": "array",
            "items": {
              "enum": [
                "identity",
                "acting",
                "abilities",
                "potion",
                "ascension",
                "limitations"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "sequences": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "work_scope": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string"
                },
                "locator": {
                  "type": "string"
                },
                "support_note": {
                  "type": "string"
                }
              },
              "required": [
                "source_id",
                "locator",
                "support_note"
              ],
              "additionalProperties": false
            }
          },
          "verification": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "unverified",
                  "lead",
                  "verified",
                  "disputed"
                ]
              },
              "reviewed_by": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reviewed_at": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "status",
              "reviewed_by",
              "reviewed_at"
            ],
            "additionalProperties": false
          },
          "notes": {
            "type": "string"
          },
          "assertion_kind": {
            "enum": [
              "canon",
              "interpretation",
              "knowledge_gap"
            ]
          }
        },
        "required": [
          "id",
          "predicate",
          "value",
          "dimensions",
          "sequences",
          "work_scope",
          "source_refs",
          "verification",
          "notes",
          "assertion_kind"
        ],
        "additionalProperties": false
      }
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "pathway_id",
    "claims",
    "note"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lotm:canon:0.3.0",
  "title": "当前途径断言"
}
